{
  "manifest_version": "0.3",
  "name": "pdfbookmarks",
  "display_name": "PDFBookmarks",
  "version": "0.1.1",
  "description": "Add verified bookmarks and clickable tables of contents to local PDFs.",
  "author": { "name": "PDFBookmarks", "url": "https://pdfbookmarks.com" },
  "homepage": "https://pdfbookmarks.com/ai-tools",
  "repository": { "type": "git", "url": "https://github.com/Yuikij/pdfbookmarks-ai" },
  "license": "MIT",
  "tools_generated": true,
  "server": {
    "type": "node",
    "entry_point": "src/cli.js",
    "mcp_config": {
      "command": "node",
      "args": ["${__dirname}/src/cli.js", "serve", "--root", "${user_config.pdf_folder}"]
    }
  },
  "compatibility": {
    "platforms": ["darwin", "win32"],
    "runtimes": { "node": ">=22.13.0" }
  },
  "user_config": {
    "pdf_folder": {
      "type": "directory",
      "title": "PDF folder",
      "description": "The folder the tool can read and save new PDFs in.",
      "required": true
    }
  }
}
